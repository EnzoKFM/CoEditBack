PORT=3000
CLIENT_URL=http://localhost:5173

# development en local ; production active l'attribut Secure des cookies (HTTPS obligatoire)
NODE_ENV=development

# Nombre de reverse proxies devant l'API (ex : 1 derrière Traefik ou Nginx, 2 pour un test via ngrok + proxy de Vite), vide sinon.
# Sans cette valeur derrière un proxy, tous les visiteurs partagent la même IP pour la limitation des tentatives.
# Ne pas la renseigner sans proxy : un client pourrait falsifier son IP via l'en-tête X-Forwarded-For.
TRUST_PROXY=

# Au moins 32 caractères, générés avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clé de chiffrement des secrets 2FA : exactement 64 caractères hexadécimaux, générés avec :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# La changer rend inutilisables les 2FA déjà activées.
TOTP_ENCRYPTION_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coedit
DB_TEST_NAME=coedit_test
DB_EXPOSED_PORT=3306

# Port de phpMyAdmin sur ta machine : http://localhost:8080
PHPMYADMIN_PORT=8080
